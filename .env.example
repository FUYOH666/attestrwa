# AttestRWA — environment reference.
#
# The local demo needs none of this: ./scripts/demo-mode.sh starts everything
# with development values. Copy to .env only to run the attester yourself or
# to deploy to a public testnet. Never commit a real key.

# ---- Attester service (apps/api) ------------------------------------------
ATTESTRWA_RPC_URL=http://127.0.0.1:8545
ATTESTRWA_CHAIN_ID=84532
# Label written into record files: anvil-fork | base-sepolia
ATTESTRWA_NETWORK=anvil-fork
# The one escrow this attester serves. Requests about any other are refused.
ATTESTRWA_ESCROW_ADDRESS=
# EAS contract (OP-stack predeploy). On-chain data sources such as the
# sanctions oracle are named by the policy pack, not configured here.
ATTESTRWA_EAS_ADDRESS=0x4200000000000000000000000000000000000021
# Key that signs attestations. Must be trusted by the escrow and must not be
# the escrow owner. Leave empty to run read-only.
ATTESTRWA_ATTESTER_PRIVATE_KEY=
# Callers of POST /attest/settlement, as comma-separated name:key pairs.
ATTESTRWA_API_KEYS=
ATTESTRWA_POLICY_FILE=data/policies/settlement-demo-v2.yaml
ATTESTRWA_REGISTRY_FILE=data/registry/payees.json
ATTESTRWA_RECORDS_DIR=records
ATTESTRWA_ATTESTATION_TTL_SECONDS=86400
ATTESTRWA_CORS_ORIGINS=http://localhost:3000
ATTESTRWA_LOG_LEVEL=INFO

# ---- Web UI (apps/web) -----------------------------------------------------
NEXT_PUBLIC_NETWORK=anvil-fork
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=
# Server-side only: the web server calls the attester, the browser never sees the key.
ATTESTER_API_URL=http://127.0.0.1:8080
ATTESTER_API_KEY=

# ---- Public testnet deployment (scripts/deploy-public-testnet.sh) ----------
# Three different keys. The deployer gets no privileges.
PUBLIC_RPC_URL=https://sepolia.base.org
PUBLIC_DEPLOYER_PRIVATE_KEY=
PUBLIC_OWNER_ADDRESS=
PUBLIC_ATTESTER_PRIVATE_KEY=
PUBLIC_BUYER_PRIVATE_KEY=
